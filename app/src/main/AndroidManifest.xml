<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.roboguard">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- testing.voiceprobe: hardware tests for multi-speaker detection -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="com.ainirobot.coreservice.robotSettingProvider" />
    <!-- robocontrol.sensorcontrol: mute the microphone via AudioManager.setMicrophoneMute -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />


    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RoboGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.RoboGuard">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <intent-filter>
                <action android:name="action.orionstar.default.app" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
        <activity android:name=".PopupActivity"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar" />

        <!-- testing.voiceprobe test screen; exported so it can be started via adb -->
        <activity
            android:name="com.example.testing.voiceprobe.VoiceProbeActivity"
            android:exported="true"
            android:label="RG Voice Test"
            android:taskAffinity="com.example.roboguard.voiceprobe">
            <!-- Launcher icon: RobotOS only grants SDK control to apps started from its home launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- testing.voiceprobe TTS test screen -->
        <activity
            android:name="com.example.testing.voiceprobe.TtsProbeActivity"
            android:exported="true"
            android:label="RG TTS Test"
            android:taskAffinity="com.example.roboguard.ttsprobe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- robocontrol.movement: "Navigation and Map" screen, opened from MainActivity (no launcher icon) -->
        <activity
            android:name="com.example.robocontrol.movement.MapNavigationActivity"
            android:exported="false"
            android:label="Navigation and Map" />

        <!-- robocontrol.conversation: popup when more than one person is talking -->
        <activity
            android:name="com.example.robocontrol.conversation.ConversationPromptActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar" />

        <!-- robocontrol.movement: popup asking whether the robot may temporarily cross a private area -->
        <activity
            android:name="com.example.robocontrol.movement.PrivacyOverrideActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.DeviceDefault.Light.Dialog.NoActionBar" />

        <!-- testing.movementprobe test screen: map, points, driving -->
        <activity
            android:name="com.example.testing.movementprobe.MovementProbeActivity"
            android:exported="true"
            android:label="RG Movement Test"
            android:taskAffinity="com.example.roboguard.movementprobe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- testing.objectprobe test screen: ORB object detection on the live camera -->
        <activity
            android:name="com.example.testing.objectprobe.ObjectProbeActivity"
            android:exported="true"
            android:label="RG Object Test"
            android:taskAffinity="com.example.roboguard.objectprobe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- testing.conversationprobe test screen: speaker change detection -->
        <activity
            android:name="com.example.testing.conversationprobe.SpeakerProbeActivity"
            android:exported="true"
            android:label="RG Speaker Test"
            android:taskAffinity="com.example.roboguard.speakerprobe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- testing.sensorprobe test screen -->
        <activity
            android:name="com.example.testing.sensorprobe.SensorProbeActivity"
            android:exported="true"
            android:label="RG Sensor Test"
            android:taskAffinity="com.example.roboguard.sensorprobe">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- robocontrol.sensorcontrol: device admin used only to disable the camera.
             Inactive until: adb shell dpm set-active-admin com.example.roboguard/com.example.robocontrol.sensorcontrol.RoboGuardDeviceAdmin -->
        <receiver
            android:name="com.example.robocontrol.sensorcontrol.RoboGuardDeviceAdmin"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/robocontrol_device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <service
            android:name=".RobotServerService"
            android:enabled="true"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.RECEIVE_BOOT_COMPLETED">
            <intent-filter android:priority="1000">
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>
</manifest>